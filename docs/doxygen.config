# OUTPUT_DIRECTORY, INPUT and USE_MDFILE_AS_MAINPAGE are added by CMake (target docs)
PROJECT_NAME            = "HydróDex"
PROJECT_BRIEF           = "A C++ code for the calculation of fluid profiles of direct and inverse phase transitions and for computing the corresponding gravitational wave spectrum within the sound shell model."
EXTRACT_ALL             = YES
EXTRACT_PRIVATE         = YES
EXTRACT_PRIV_VIRTUAL    = YES
EXTRACT_PACKAGE         = YES
EXTRACT_STATIC          = YES
EXTRACT_LOCAL_METHODS   = YES
EXTRACT_ANON_NSPACES    = YES
SORT_MEMBER_DOCS        = NO
GENERATE_DEPRECATEDLIST = YES
WARN_NO_PARAMDOC        = YES
WARN_IF_UNDOC_ENUM_VAL  = YES
MARKDOWN_ID_STYLE       = GITHUB
FILE_PATTERNS           = *.cpp \
                          *.hpp
GENERATE_HTML           = YES
GENERATE_TREEVIEW       = YES
GENERATE_LATEX          = NO
HAVE_DOT                = NO
USE_MATHJAX             = YES
EXTRA_PACKAGES          = amsmath amssymb amsfonts
